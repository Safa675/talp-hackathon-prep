# Secrets: the Vertex key lives only in .env, never in code or the submission ZIP.
.env
.env.*
*.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS and editor files
.DS_Store
.~lock.*#
.Rhistory

# Generated outputs (test runs are rebuilt on demand; final runs go into the ZIP)
outputs/
submission*/
team-*_submission*.zip

# Third-party documents that are not ours to publish
docs/guidelines/*.pdf
